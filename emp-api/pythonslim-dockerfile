FROM python:3.12-slim
WORKDIR /app
ARG APP_VERSION=1.0
ENV PORT=5000
RUN useradd -m appuser
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=appuser:appuser app.py .
USER appuser
EXPOSE 5000
HEALTHCHECK --interval=30s \
--timeout=5s \
--start-period=10s \
--retries=3 \
CMD curl -f http://localhost || exit 1
CMD ["python3","app.py"]

